#!/usr/bin/env bash
# CKAD drill runner. Usage: ./drill [today] | ./drill run <set> | ./drill mock <set> | ./drill stats | ./drill clean
set -u
ROOT=$(cd "$(dirname "$0")" && pwd)
LOG=$ROOT/progress/log.csv
mkdir -p "$ROOT/progress"; [ -f "$LOG" ] || echo "date,mode,set,task,domain,budget_min,secs,result" > "$LOG"

field() { sed -n "s/^$2: *//p" "$ROOT/tasks/$1/task.md" | head -1 | tr -d '\r'; }
body()  { sed '1,/^---/d' "$ROOT/tasks/$1/task.md"; }
ids()   { grep -v '^#' "$ROOT/sets/$1.txt" | tr -d '\r' | grep .; }
log()   { echo "$(date +%F),$1,$2,$3,$(field "$3" domain),$(field "$3" budget),$4,$5" >> "$LOG"; }
ask()   { read -rp "$1" REPLY || exit; }
check() { NS=$1 bash "$ROOT/tasks/$1/check.sh"; }

# drill deletes namespaces, so it must never touch a real cluster.
# k3s names its context "default", which says nothing, so match its local API server address instead.
local_only() {
  ctx=$(kubectl config current-context 2>/dev/null)
  server=$(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)
  [ "$ctx" = docker-desktop ] && return
  [ "$server" = https://127.0.0.1:6443 ] && return
  echo "kubectl points at '$ctx' ($server), not docker-desktop or a local k3s. Switch to one of them." >&2; exit 1
}

# Each task gets a fresh namespace named after the task.
# A half-prepared task looks like a broken solution, so any failed step stops the drill.
prep() {
  if ! out=$( { kubectl delete ns "$1" --ignore-not-found --wait &&
      kubectl create ns "$1" && kubectl label ns "$1" ckad-drill=1 &&
      { [ ! -f "$ROOT/tasks/$1/setup.sh" ] || NS=$1 bash -e "$ROOT/tasks/$1/setup.sh"; }; } 2>&1 ); then
    echo "$out" >&2
    echo "Setup of $1 failed. Is the cluster running? Fix it and run ./drill again." >&2; exit 1
  fi
}

run() {
  for id in $(ids "$1"); do
    echo "Preparing $id..."; prep "$id"
    printf '\n== %s  [%s, budget %s min]  namespace: %s\n\n' "$id" "$(field "$id" domain)" "$(field "$id" budget)" "$id"
    body "$id"; echo
    start=$(date +%s); tried=
    while :; do
      ask "Enter = check, s = skip/give up, q = quit: "
      secs=$(( $(date +%s) - start ))
      case $REPLY in
        q) return ;;
        s) log run "$1" "$id" "$secs" "${tried:-skip}"; break ;;
      esac
      if check "$id"; then
        log run "$1" "$id" "$secs" pass
        echo "PASS in $((secs/60))m$((secs%60))s (budget $(field "$id" budget)m)"; break
      fi
      tried=fail
    done
  done
}

mock() {
  sheet=$ROOT/progress/$1-$(date +%F).md
  echo "# $1 ($(date +%F)) - 120 minutes" > "$sheet"
  total=0
  for id in $(ids "$1"); do
    echo "Preparing $id..."; prep "$id"
    total=$((total + $(field "$id" budget)))
    { printf '\n## %s  (weight %s, namespace %s)\n\n' "$id" "$(field "$id" budget)" "$id"; body "$id"; } >> "$sheet"
  done
  echo; echo "Tasks are in $sheet"; echo "Your 120 minutes start now ($(date +%H:%M))."
  start=$(date +%s)
  ask "Press Enter when you finish or time runs out: "
  secs=$(( $(date +%s) - start )); got=0
  for id in $(ids "$1"); do
    if check "$id" >/dev/null; then r=pass; got=$((got + $(field "$id" budget))); else r=fail; fi
    printf '  %-4s %s\n' "$r" "$id"; log mock "$1" "$id" "$secs" "$r"
  done
  echo "Score: $((100 * got / total))% in $((secs/60)) min (pass mark 66%)"
}

stats() {
  awk -F, 'NR>1 && $8!="skip" { n[$5]++; if ($8=="pass") { p[$5]++; if ($2=="run") { t[$5]+=$7/($6*60); c[$5]++ } } }
    END { printf "%-18s %5s %6s %12s\n", "domain", "tries", "pass", "time/budget"
          for (d in n) printf "%-18s %5d %5.0f%% %12s\n", d, n[d], 100*p[d]/n[d], c[d] ? sprintf("%.2f", t[d]/c[d]) : "-" }' "$LOG"
}

today() {
  case $(date +%u) in 6|7) weekend=1 ;; *) weekend= ;; esac
  review= run= mock=
  for f in $(ls -t "$ROOT"/sets/*.txt); do
    s=${f##*/}; s=${s%.txt}
    n=$(( $(ids "$s" | wc -l) ))
    got=$(( $(awk -F, -v s="$s" '$3==s{print $4}' "$LOG" | sort -u | wc -l) ))
    if [ "$got" -lt "$n" ]; then
      case $s in mock-*) mock=${mock:-$s} ;; *) run=${run:-$s} ;; esac
    elif ! ls "$ROOT"/learning-records/*-"$s"-review.md >/dev/null 2>&1; then
      review=${review:-$s}
    fi
  done
  if [ -n "$review" ]; then
    echo "Tell Claude you're done with $review, to review its failed and skipped tasks."
  elif [ -n "$weekend" ] && [ -n "$mock" ]; then
    echo "Run: ./drill mock $mock"; mock=
  elif [ -n "$run" ]; then
    lesson=$(sed -n 's/^# lesson: *//p' "$ROOT/sets/$run.txt" | head -1 | tr -d '\r')
    if [ -n "$lesson" ] && [ -f "$ROOT/$lesson" ]; then
      echo "Read $lesson first (10 min): http://localhost:8000/$lesson"
      echo "Server: npx --yes serve@14.2.6 -l tcp://127.0.0.1:8000"
    fi
    echo "Run: ./drill run $run"
  else
    echo "Open Claude: /mattpocock-skills:teach next session"
  fi
  [ -z "$mock" ] || echo "Mock pending: $mock (./drill mock $mock, 120 min)"
}

# Helm releases live in the task namespaces, so deleting those removes them too.
clean() {
  kubectl delete ns -l ckad-drill=1
  for d in "$ROOT"/tasks/*/; do rm -rf "$HOME/ckad/$(basename "$d")"; done
}

case ${1:-} in
  ''|today) today; echo; sed -n '2p' "$0" ;;
  run|mock) local_only
    # Emptied, not deleted: a terminal already inside workdir keeps a valid directory.
    mkdir -p "$ROOT/workdir" && find "$ROOT/workdir" -mindepth 1 -delete
    echo "workdir is empty. Open a second terminal in $ROOT/workdir and keep your files there (git ignores it)."
    "$1" "$2"
    ask "Delete the drill namespaces and ~/ckad task folders? [y/N] "
    [ "$REPLY" = y ] && clean ;;
  stats) stats ;;
  clean) local_only; clean ;;
  *) sed -n '2p' "$0" ;;
esac
